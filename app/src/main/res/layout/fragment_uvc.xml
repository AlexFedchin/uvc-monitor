<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- The library injects the camera render view into this empty container -->
    <FrameLayout
        android:id="@+id/cameraViewContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Rule-of-thirds overlay, drawn on top of the preview -->
    <com.example.uvcmonitor.ThirdsGridView
        android:id="@+id/gridView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Overlay controls, bottom-right -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="12dp"
        android:orientation="horizontal">

        <!-- Preview resolution toggle; label shows the *current* resolution -->
        <TextView
            android:id="@+id/resBtn"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="40dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:gravity="center"
            android:background="@drawable/bg_control"
            android:clickable="true"
            android:focusable="true"
            android:text="@string/res_720p"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Grid on/off -->
        <ImageButton
            android:id="@+id/gridBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:padding="8dp"
            android:background="@drawable/bg_control"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_grid"
            android:contentDescription="@string/toggle_grid" />
    </LinearLayout>
</FrameLayout>
